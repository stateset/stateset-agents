2.0", "vulns": []}, {"name": "markupsafe", "version": "3.0.3", "vulns": []}, {"name": "mccabe", "version": "0.7.0", "vulns": []}, {"name": "mcp", "version": "1.29.0", "vulns": [{"id": "CVE-2026-59951", "fix_versions": ["1.30.0", "2.2.0"], "aliases": ["GHSA-84m7-p3x7-pcfv"], "description": "### Summary In affected versions, a Streamable HTTP server in stateful mode (the default) never reclaimed session state:  - sessions did not expire; - a client `DELETE` ended the session but left its entry registered; - a session whose first request was refused stayed registered with a running task.  Each session also kept its parsed `initialize` parameters, and the number of sessions was unlimited. A client that could reach the endpoint could grow server memory without bound using ordinary short requests; only a restart reclaimed it.  ### Am I affected? Yes, if you serve MCP over Streamable HTTP in stateful mode and clients you do not fully trust can reach the endpoint. Stateful mode is the default for:  - `FastMCP` (1.x) - `MCPServer` and `Server.streamable_http_app()` (2.x) - `StreamableHTTPSessionManager`  Affected versions: 1.8.0 through 1.29.1, and 2.0.0 through 2.1.1.  Not affected:  - servers on 1.12.0 or later passing `stateless_http=True` (no sessions are kept) - servers using only the stdio or SSE transports  Authentication limits who can open sessions, not how many a token holder can open.  ### Fix Upgrade to `mcp` 1.30.0 (1.x) or 2.2.0 (2.x) or later. In those versions:  - a session with no request in flight for `session_idle_timeout` seconds (default 1800) is closed and its ID then answers `404`; open streams and in-progress requests keep it alive; - at most `max_sessions` sessions exist at once (default 10000); a request that would open another is answered `503`; - a session is discarded as soon as it ends, whether by `DELETE`, expiry, or a refused opening request.  Both settings are keyword arguments on `FastMCP(...)` (1.x), `MCPServer.run()` / `streamable_http_app()` (2.x) and `StreamableHTTPSessionManager`; `None` disables them.  This bounds retention rather than eliminating it: a live session still holds its `initialize` parameters (up to roughly twice the 4 MiB body limit), and an `initialize` with invalid parameters still opens a session that expires like any other. On a small host, lower `session_idle_timeout`, `max_sessions` and `max_request_body_size` to fit.  If you cannot upgrade yet, pass `stateless_http=True` (1.12.0 or later) where you need no per-session state, or restrict who can reach the endpoint."}]}, {"name": "mdurl", "version": "0.1.2", "vulns": []}, {"name": "mpmath", "version": "1.3.0", "vulns": []}, {"name": "msgpack", "version": "1.2.2", "vulns": []}, {"name": "multidict", "version": "6.9.1", "vulns": []}, {"name": "multiprocess", "version": "0.70.19", "vulns": []}, {"name": "mypy", "version": "2.3.0", "vulns": []}, {"name": "mypy-extensions", "version": "1.1.0", "vulns": []}, {"name": "narwhals", "version": "2.24.0", "vulns": []}, {"name": "networkx", "version": "3.6.1", "vulns": []}, {"name": "nodeenv", "version": "1.10.0", "vulns": []}, {"name": "numpy", "version": "2.4.6", "vulns": []}, {"name": "nvidia-cublas", "version": "13.1.1.3", "vulns": []}, {"name": "nvidia-cuda-cupti", "version": "13.0.85", "vulns": []}, {"name": "nvidia-cuda-nvrtc", "version": "13.0.88", "vulns": []}, {"name": "nvidia-cuda-runtime", "version": "13.0.96", "vulns": []}, {"name": "nvidia-cudnn-cu13", "version": "9.20.0.48", "vulns": []}, {"name": "nvidia-cufft", "version": "12.0.0.61", "vulns": []}, {"name": "nvidia-cufile", "version": "1.15.1.6", "vulns": []}, {"name": "nvidia-curand", "version": "10.4.0.35", "vulns": []}, {"name": "nvidia-cusolver", "version": "12.0.4.66", "vulns": []}, {"name": "nvidia-cusparse", "version": "12.6.3.3", "vulns": []}, {"name": "nvidia-cusparselt-cu13", "version": "0.8.1", "vulns": []}, {"name": "nvidia-nccl-cu13", "version": "2.29.7", "vulns": []}, {"name": "nvidia-nvjitlink", "version": "1