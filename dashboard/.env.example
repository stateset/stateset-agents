# Copy to .env.local and adjust as needed. Both variables are optional —
# the dashboard works same-origin against a proxy with no configuration.

# Absolute base URL for the Training Lab API. Leave unset to use the
# same-origin default (/api/lab), which requires a reverse proxy that
# forwards /api/lab/* to the backend. Set this to point the dashboard at a
# remote API origin instead, e.g.:
# VITE_API_BASE_URL=https://api.example.com/api/lab

# Build-time API key sent as the `X-API-Key` header (and as the `api_key`
# WebSocket query param). Can also be set/overridden at runtime via
# api.setApiKey() (persisted to localStorage under `stateset.apiKey`).
# VITE_API_KEY=changeme
