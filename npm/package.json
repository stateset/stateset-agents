{
  "name": "@stateset/agents",
  "version": "0.47.1",
  "description": "Typed Node.js client for the StateSet Agents API",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test && npm run typecheck",
    "typecheck": "tsc --project tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stateset",
    "agents",
    "reinforcement-learning",
    "llm",
    "openai",
    "anthropic"
  ],
  "license": "BUSL-1.1",
  "author": "StateSet Team <team@stateset.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stateset/stateset-agents.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/stateset/stateset-agents/issues"
  },
  "homepage": "https://github.com/stateset/stateset-agents#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
