{
  "schema_version": 1,
  "kind": "stateset-paired-agent-harness-config",
  "suites": {
    "tau-bench": {
      "repository_path": "REPLACE_WITH_PINNED_TAU_BENCH_CHECKOUT",
      "timeout_seconds": 14400,
      "cost_source": "provider-api",
      "command": [
        "python",
        "REPLACE_WITH_TAU_BENCH_DRIVER.py",
        "--policy", "{policy}",
        "--model", "{model}",
        "--model-revision", "{model_revision}",
        "--seed", "{seed}",
        "--suite", "{suite}",
        "--suite-revision", "{suite_revision}",
        "--split", "{split}",
        "--evaluation-config-json", "{evaluation_config_json}",
        "--output", "{output}",
        "--artifact-dir", "{artifact_dir}"
      ]
    },
    "bfcl": {
      "repository_path": "REPLACE_WITH_PINNED_BFCL_CHECKOUT",
      "timeout_seconds": 14400,
      "cost_source": "provider-api",
      "command": [
        "python",
        "REPLACE_WITH_BFCL_DRIVER.py",
        "--policy", "{policy}",
        "--model", "{model}",
        "--model-revision", "{model_revision}",
        "--seed", "{seed}",
        "--suite", "{suite}",
        "--suite-revision", "{suite_revision}",
        "--split", "{split}",
        "--evaluation-config-json", "{evaluation_config_json}",
        "--output", "{output}",
        "--artifact-dir", "{artifact_dir}"
      ]
    },
    "swe-bench-verified": {
      "repository_path": "REPLACE_WITH_PINNED_SWE_BENCH_CHECKOUT",
      "timeout_seconds": 43200,
      "cost_source": "provider-api",
      "command": [
        "python",
        "REPLACE_WITH_SWE_BENCH_DRIVER.py",
        "--policy", "{policy}",
        "--model", "{model}",
        "--model-revision", "{model_revision}",
        "--seed", "{seed}",
        "--suite", "{suite}",
        "--suite-revision", "{suite_revision}",
        "--split", "{split}",
        "--evaluation-config-json", "{evaluation_config_json}",
        "--output", "{output}",
        "--artifact-dir", "{artifact_dir}"
      ]
    }
  }
}
