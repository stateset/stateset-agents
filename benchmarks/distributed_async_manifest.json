{
  "schema_version": 1,
  "kind": "stateset-distributed-async-manifest",
  "protocol": "stateset-distributed-async-v1",
  "framework_version": "0.70.0",
  "provider": "runpod",
  "cost_source": "runpod-api",
  "seeds": [42, 1337, 2026],
  "scenarios": [
    "steady_state_soak",
    "worker_exit",
    "controller_restart",
    "network_interruption"
  ],
  "minimum_duration_seconds": {
    "steady_state_soak": 43200,
    "worker_exit": 300,
    "controller_restart": 300,
    "network_interruption": 300
  },
  "config": {
    "max_policy_lag": 1,
    "queue_capacity": 1024,
    "batch_size": 32,
    "checkpoint_interval_updates": 25,
    "scenario_duration_seconds": {
      "steady_state_soak": 43500,
      "worker_exit": 360,
      "controller_restart": 360,
      "network_interruption": 360
    },
    "preflight_duration_seconds": 120,
    "fault_at_seconds": 120,
    "network_partition_seconds": 30,
    "rollout_interval_seconds": 0.25,
    "heartbeat_interval_seconds": 0.5,
    "lease_ttl_seconds": 10,
    "request_timeout_seconds": 5,
    "worker_restart_delay_seconds": 2,
    "controller_restart_delay_seconds": 2,
    "shutdown_grace_seconds": 30,
    "deduplication_capacity": 2000000,
    "device": "cpu",
    "max_cost_usd_per_scenario": {
      "steady_state_soak": 4.0,
      "worker_exit": 0.5,
      "controller_restart": 0.5,
      "network_interruption": 0.5
    }
  },
  "topology": {
    "node_count": 2,
    "worker_count": 4,
    "accelerator": "CPU",
    "accelerator_driver": "none (CPU-only PyTorch)",
    "interconnect": "public-internet-tcp (RunPod exposed TCP port)"
  },
  "command": [
    "python",
    "benchmarks/distributed_async_runpod_driver.py",
    "--scenario",
    "{scenario}",
    "--seed",
    "{seed}",
    "--mode",
    "{mode}",
    "--protocol",
    "{protocol}",
    "--framework-version",
    "{framework_version}",
    "--config-json",
    "{config_json}",
    "--config-sha256",
    "{config_sha256}",
    "--output",
    "{adapter_output}",
    "--artifact-dir",
    "{artifact_dir}",
    "--node-count",
    "2",
    "--worker-count",
    "4",
    "--accelerator",
    "CPU",
    "--accelerator-driver",
    "none (CPU-only PyTorch)",
    "--interconnect",
    "public-internet-tcp (RunPod exposed TCP port)",
    "--cpu-flavor",
    "cpu3c",
    "--vcpus",
    "4"
  ]
}
