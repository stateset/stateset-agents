        "--dataset-revision",
        "{dataset_revision}",
        "--seed",
        "{seed}",
        "--config-json",
        "{config_json}",
        "--artifact-dir",
        "{artifact_dir}",
        "--adapter-output",
        "{adapter_output}"
      ]
    }
