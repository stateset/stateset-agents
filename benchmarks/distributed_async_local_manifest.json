{
  "schema_version": 1,
  "kind": "stateset-distributed-async-manifest",
  "protocol": "stateset-distributed-async-v1",
  "framework_version": "0.69.0",
  "provider": "local",
  "cost_source": "local-meter",
  "diagnostic_note": "Process groups on one host over loopback TCP. Exercises the full driver/runner/validator pipeline; the publication gate rejects provider=local. Run with --preflight (the runner's measured mode requires a 12 h soak minimum).",
  "seeds": [42, 1337, 2026],
  "scenarios": [
    "steady_state_soak",
    "worker_exit",
    "controller_restart",
    "network_interruption"
  ],
  "minimum_duration_seconds": {
    "steady_state_soak": 43200,
    "worker_exit": 300,
    "controller_restart": 300,
    "network_interruption": 300
  },
  "config": {
    "max_policy_lag": 1,
    "queue_capacity": 1024,
    "batch_size": 32,
    "checkpoint_interval_updates": 10,
    "scenario_duration_seconds": {
      "steady_state_soak": 60,
      "worker_exit": 30,
      "controller_restart": 30,
      "network_interruption": 30
    },
    "preflight_duration_seconds": 60,
    "fault_at_seconds": 10,
    "network_partition_seconds": 12,
    "rollout_interval_seconds": 0.05,
    "heartbeat_interval_seconds": 0.5,
    "lease_ttl_seconds": 10,
    "request_timeout_seconds": 3,
    "worker_restart_delay_seconds": 1,
    "controller_restart_delay_seconds": 1,
    "shutdown_grace_seconds": 10,
    "device": "cpu"
  },
  "topology": {
    "node_count": 2,
    "worker_count": 4,
    "accelerator": "CPU",
    "accelerator_driver": "none (CPU-only PyTorch)",
    "interconnect": "loopback-tcp"
  },
  "command": [
    "python",
    "benchmarks/distributed_async_local_driver.py",
    "--scenario",
    "{scenario}",
    "--seed",
    "{seed}",
    "--mode",
    "{mode}",
    "--protocol",
    "{protocol}",
    "--framework-version",
    "{framework_version}",
    "--config-json",
    "{config_json}",
    "--config-sha256",
    "{config_sha256}",
    "--output",
    "{adapter_output}",
    "--artifact-dir",
    "{artifact_dir}",
    "--node-count",
    "2",
    "--worker-count",
    "4",
    "--accelerator",
    "CPU",
    "--accelerator-driver",
    "none (CPU-only PyTorch)",
    "--interconnect",
    "loopback-tcp"
  ]
}
